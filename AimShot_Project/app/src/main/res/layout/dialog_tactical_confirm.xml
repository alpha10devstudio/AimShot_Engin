<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="24dp"
    android:background="@drawable/bg_dialog_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Optional Header Icon -->
    <ImageView
        android:id="@+id/iv_confirm_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_game_icon_container"
        android:contentDescription="@string/app_name"
        android:padding="9dp"
        android:src="@drawable/ic_aimshot_logo" />

    <!-- Optional Progress Indicator (for Live Connectivity Check) -->
    <ProgressBar
        android:id="@+id/pb_confirm_loading"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginBottom="12dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/accent_primary"
        android:visibility="gone" />

    <!-- Title -->
    <TextView
        android:id="@+id/tv_confirm_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/no_internet_title"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Message -->
    <TextView
        android:id="@+id/tv_confirm_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/no_internet_msg"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:id="@+id/layout_confirm_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_confirm_negative"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_tactical_border"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:text="@string/action_close"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_confirm_positive"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_accent"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:text="@string/btn_retry"
            android:textAllCaps="false"
            android:textColor="@color/text_on_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
