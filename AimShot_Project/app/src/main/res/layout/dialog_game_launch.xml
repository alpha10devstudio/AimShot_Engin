<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="24dp"
    android:background="@drawable/bg_dialog_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Glowing AimShot Engine HUD Icon -->
    <RelativeLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/iv_launch_game_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_game_icon_container"
            android:contentDescription="Target Game"
            android:padding="4dp"
            android:src="@drawable/game_carrom" />
    </RelativeLayout>

    <!-- Game Title -->
    <TextView
        android:id="@+id/tv_launch_game_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Carrom Disc Pool"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Subtitle: Tactical Aim Engine Initializing -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="AIMSHOT ENGINE OVERLAY"
        android:textColor="@color/accent_primary"
        android:textSize="10.5sp"
        android:textStyle="bold" />

    <!-- Tactical Progress Indicator -->
    <ProgressBar
        android:id="@+id/progress_launch"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginTop="20dp"
        android:indeterminateTint="@color/accent_primary" />

    <!-- Dynamic Status Message -->
    <TextView
        android:id="@+id/tv_launch_status_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/launching_status_init"
        android:textColor="@color/text_secondary"
        android:textSize="12.5sp" />

    <!-- Cancel / Abort Button -->
    <Button
        android:id="@+id/btn_launch_abort"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_button_tactical_border"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="CANCEL"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
