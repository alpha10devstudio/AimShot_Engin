<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="24dp"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Header Icon -->
    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="10dp"
        android:background="@color/icon_tint_box_bg"
        android:contentDescription="@string/setting_language"
        android:padding="9dp"
        android:src="@drawable/ic_globe"
        app:tint="@color/accent_primary" />

    <!-- Title -->
    <TextView
        android:id="@+id/tv_lang_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/setting_language"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="@string/select_language_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="12.5sp" />

    <!-- Option 1: English -->
    <LinearLayout
        android:id="@+id/row_lang_en"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_game_card_normal"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:id="@+id/iv_radio_en"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="English"
            android:src="@drawable/ic_radio_checked" />

        <TextView
            android:id="@+id/tv_lang_en"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="English"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Option 2: Bengali -->
    <LinearLayout
        android:id="@+id/row_lang_bn"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_game_card_normal"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:id="@+id/iv_radio_bn"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Bengali"
            android:src="@drawable/ic_radio_unchecked" />

        <TextView
            android:id="@+id/tv_lang_bn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="বাংলা (Bengali)"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Option 3: Hindi -->
    <LinearLayout
        android:id="@+id/row_lang_hi"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_game_card_normal"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:id="@+id/iv_radio_hi"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Hindi"
            android:src="@drawable/ic_radio_unchecked" />

        <TextView
            android:id="@+id/tv_lang_hi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="हिन्दी (Hindi)"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_lang_close"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_button_tactical_border"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:text="@string/action_close"
        android:textAllCaps="false"
        android:textColor="@color/accent_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
