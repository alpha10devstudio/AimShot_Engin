<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_tactical_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Game Icon Container -->
    <ImageView
        android:id="@+id/iv_item_game_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="#1A39B9FF"
        android:contentDescription="Game"
        android:padding="6dp"
        android:src="@drawable/ic_aimshot_logo" />

    <!-- Info Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_item_game_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PUBG Mobile"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_item_game_features"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Aim Assist • Crosshair • FPS Boost"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Verified Status Checkmark -->
    <ImageView
        android:id="@+id/iv_item_game_check"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="Verified"
        android:src="@drawable/ic_check_circle" />

</LinearLayout>
