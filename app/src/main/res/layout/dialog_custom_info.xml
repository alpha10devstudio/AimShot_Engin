<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_dialog_card"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Rounded Tactical Header Icon Badge -->
        <ImageView
            android:id="@+id/iv_dialog_info_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_dialog_icon_badge"
            android:contentDescription="@string/app_name"
            android:padding="10dp"
            android:src="@drawable/ic_aimshot_logo" />

        <!-- Dialog Title -->
        <TextView
            android:id="@+id/tv_dialog_info_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Privacy &amp; Security"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Dialog Body Message -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp"
            android:overScrollMode="ifContentScrolls">

            <TextView
                android:id="@+id/tv_dialog_info_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="AimShot Engine guarantees privacy and security."
                android:textColor="@color/text_secondary"
                android:textSize="13.5sp" />
        </ScrollView>

        <!-- Action Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_dialog_info_positive"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_accent"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:text="@string/btn_understood"
            android:textAllCaps="false"
            android:textColor="@color/text_on_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</FrameLayout>
