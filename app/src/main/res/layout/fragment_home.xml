<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_aimshot_logo" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AimShot "
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Engine"
                            android:textColor="@color/accent_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/slogan"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_notifications"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Notifications"
                android:padding="6dp"
                android:src="@drawable/ic_bell" />
        </RelativeLayout>

        <!-- Compact Hero Banner Card: AimShot Engine Pro Gaming Toolkit -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_tactical_card_glow"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Logo"
                android:src="@drawable/ic_aimshot_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AimShot "
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Engine"
                        android:textColor="@color/accent_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pro_gaming_toolkit"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#2039B9FF"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="v1.0.0"
                android:textColor="@color/accent_primary"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Home Image Carousel with Navigation Arrows -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="155dp"
            android:layout_marginBottom="8dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/bg_card">

                <ViewFlipper
                    android:id="@+id/home_carousel_flipper"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autoStart="true"
                    android:flipInterval="4000"
                    android:inAnimation="@android:anim/fade_in"
                    android:outAnimation="@android:anim/fade_out">

                    <!-- Slide 1: Auto Aim & Guideline Engine -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/iv_carousel_1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Feature 1 Banner"
                            android:scaleType="centerCrop"
                            android:src="@drawable/carousel_image_1" />

                        <!-- Dark Overlay for Readability -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#A6000000" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_active"
                                android:paddingStart="8dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="3dp"
                                android:text="SAFE CORE"
                                android:textColor="@color/bg_main"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_alignParentEnd="true"
                                android:contentDescription="Shield"
                                android:src="@drawable/ic_shield" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_alignParentBottom="true"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Auto Aim &amp; Guideline Engine"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Engineered for Carrom Disc Pool &amp; Billiards"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="10.5sp" />
                            </LinearLayout>
                        </RelativeLayout>
                    </RelativeLayout>

                    <!-- Slide 2: Zero Recoil & FPS Stabilization -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/iv_carousel_2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Feature 2 Banner"
                            android:scaleType="centerCrop"
                            android:src="@drawable/carousel_image_2" />

                        <!-- Dark Overlay for Readability -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#A6000000" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="#3339B9FF"
                                android:paddingStart="8dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="3dp"
                                android:text="PRO TOOLKIT"
                                android:textColor="@color/accent_primary"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_alignParentEnd="true"
                                android:contentDescription="Shield"
                                android:src="@drawable/ic_shield" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_alignParentBottom="true"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Zero Recoil &amp; FPS Boost"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Ultra low latency 120 FPS game acceleration"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="10.5sp" />
                            </LinearLayout>
                        </RelativeLayout>
                    </RelativeLayout>

                    <!-- Slide 3: Auto-Trajectory & Bank Shots -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/iv_carousel_3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Feature 3 Banner"
                            android:scaleType="centerCrop"
                            android:src="@drawable/carousel_image_3" />

                        <!-- Dark Overlay for Readability -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#A6000000" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="#3339B9FF"
                                android:paddingStart="8dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="3dp"
                                android:text="TACTICAL AI"
                                android:textColor="@color/accent_primary"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_alignParentEnd="true"
                                android:contentDescription="Shield"
                                android:src="@drawable/ic_shield" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_alignParentBottom="true"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Auto-Trajectory &amp; Bank Shots"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Precision guideline calculations for all angles"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="10.5sp" />
                            </LinearLayout>
                        </RelativeLayout>
                    </RelativeLayout>
                </ViewFlipper>
            </androidx.cardview.widget.CardView>

            <!-- Carousel Left Arrow Navigation Button -->
            <ImageView
                android:id="@+id/btn_carousel_prev"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_carousel_nav_btn"
                android:clickable="true"
                android:contentDescription="Previous Slide"
                android:elevation="6dp"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_chevron_left" />

            <!-- Carousel Right Arrow Navigation Button -->
            <ImageView
                android:id="@+id/btn_carousel_next"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_carousel_nav_btn"
                android:clickable="true"
                android:contentDescription="Next Slide"
                android:elevation="6dp"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_chevron_right" />
        </RelativeLayout>

        <!-- Carousel Indicator Dots (3 Dots, Active is an elongated pill) -->
        <LinearLayout
            android:id="@+id/layout_carousel_indicators"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/dot_1"
                android:layout_width="20dp"
                android:layout_height="6dp"
                android:layout_margin="3dp"
                android:src="@drawable/indicator_dot_active" />

            <ImageView
                android:id="@+id/dot_2"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_margin="3dp"
                android:src="@drawable/indicator_dot_inactive" />

            <ImageView
                android:id="@+id/dot_3"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_margin="3dp"
                android:src="@drawable/indicator_dot_inactive" />
        </LinearLayout>

        <!-- Supported Games Section Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Games"
                    android:src="@drawable/ic_aimshot_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/supported_games"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_view_all_games"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:text="@string/view_all"
                android:textColor="@color/accent_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- 4-Column Grid of Games -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_games_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:nestedScrollingEnabled="false" />

        <!-- 1. Login Card: Displayed ONLY when user is NOT logged in -->
        <LinearLayout
            android:id="@+id/card_login_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_tactical_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_login_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="Status"
                    android:src="@drawable/ic_lock" />

                <TextView
                    android:id="@+id/tv_login_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/you_are_not_logged_in"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_login_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:text="@string/login_desc"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_home_login"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_button_accent"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="@string/login_now"
                android:textAllCaps="false"
                android:textColor="@color/bg_main"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. Launch Game Container: Displayed ONLY when user IS logged in -->
        <LinearLayout
            android:id="@+id/card_launch_game"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_launch_game"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_button_launch"
                android:drawableStart="@drawable/ic_aimshot_logo"
                android:drawablePadding="10dp"
                android:elevation="4dp"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:stateListAnimator="@null"
                android:text="Launch The Game"
                android:textAllCaps="false"
                android:textColor="@color/bg_main"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
