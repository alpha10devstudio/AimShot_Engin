<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_dialog_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Glowing AimShot Engine HUD Icon -->
        <RelativeLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginBottom="14dp">

            <ImageView
                android:id="@+id/iv_launch_game_icon"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_dialog_icon_badge"
                android:contentDescription="Target Game"
                android:padding="6dp"
                android:src="@drawable/game_carrom" />
        </RelativeLayout>

        <!-- Game Title -->
        <TextView
            android:id="@+id/tv_launch_game_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Carrom Disc Pool"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Subtitle: Tactical Aim Engine Initializing -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="AIMSHOT ENGINE OVERLAY"
            android:textColor="@color/accent_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Tactical Progress Indicator -->
        <ProgressBar
            android:id="@+id/progress_launch"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginTop="18dp"
            android:indeterminateTint="@color/accent_primary" />

        <!-- Dynamic Status Message -->
        <TextView
            android:id="@+id/tv_launch_status_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/launching_status_init"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp" />

        <!-- Cancel / Abort Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_launch_abort"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_tactical_border"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:text="@string/btn_cancel"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>
</FrameLayout>
