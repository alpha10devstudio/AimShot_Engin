<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_game_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    android:background="@drawable/bg_game_card_normal"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Game Icon with Top-Right Status Dot -->
    <RelativeLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_game_icon_container">

        <ImageView
            android:id="@+id/iv_grid_game_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Game Icon"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/game_carrom" />

        <!-- Status Dot in Top Right Corner -->
        <ImageView
            android:id="@+id/iv_grid_status_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_margin="3dp"
            android:contentDescription="Status Dot"
            android:src="@drawable/dot_game_active" />
    </RelativeLayout>

    <!-- Game Name -->
    <TextView
        android:id="@+id/tv_grid_game_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Carrom Disc Pool"
        android:textColor="@color/text_primary"
        android:textSize="10sp"
        android:textStyle="bold" />

    <!-- Status Label: Active / Locked -->
    <TextView
        android:id="@+id/tv_grid_game_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Active"
        android:textColor="#49DCA0"
        android:textSize="8.5sp"
        android:textStyle="bold" />

</LinearLayout>
